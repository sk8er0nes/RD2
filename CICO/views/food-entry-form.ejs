<div class="mb-3">
  <label class="form-label" for="dateTime">Date and Time</label>
  <input class="form-control" type="datetime-local" id="dateTime" name="dateTime" value="<%=
    foodEntry?.dateTime?.replace(' ', 'T').slice(0, 16) %>">
</div>
<div class="mb-3">
  <label class="form-label" for="foodName">Food Name</label>
  <input class="form-control" type="text" id="foodName" name="foodName" value="<%= foodEntry?.foodName %>">
</div>
<div class="mb-3">
  <label class="form-label" for="calories">Calories</label>
  <input class="form-control" type="number" id="calories" name="calories" value="<%= foodEntry?.calories %>">
</div>
<div class="mb-3">
  <label class="form-label" for="servingSize">Serving Size</label>
  <input class="form-control" type="number" id="servingSize" name="servingSize" value="<%= foodEntry?.servingSize %>">
  <label class="form-label" for="unit">Unit</label>
  <select class="form-select" id="unit" name="unit">
    <option value="serving"
<%= foodEntry?.unit=="serving"?"selected" :""%>
      >Serving</option>
    <option value="gram"
<%= foodEntry?.unit=="gram"?"selected" :""%>
      >Gram</option>
    <option value="ounce"
<%= foodEntry?.unit=="ounce"?"selected" :""%>
      >Ounce</option>
    <option value="pound"
<%= foodEntry?.unit=="pound"?"selected" :""%>
      >Pound</option>
  </select>
</div>
<fieldset class="mb-3">
  <legend class="fs-6">Meal</legend>
  <% for (let m of meals) { %>
    <div class="form-check form-check-inline">
      <input class="form-check-input" type="radio" name="meal"
        id="meal-<%= m.id %>" value="<%= m.id %>" required
<%= (foodEntry?.meal_id??1)== m.id?"checked" :""%>>
      <label class="form-check-label" for="meal-<%= m.id %>">
      <%= m.name %>
    </label>
    </div>
  <% } %>
</fieldset>
<fieldset class="mb-3">
  <legend class="fs-6">Tags</legend>
  <% for (let t of tags) { %>
    <div class="form-check form-check-inline">
      <input class="form-check-input" type="checkbox" name="tags[]"
        id="tag-<%= t.id %>" value="<%= t.id %>"
<%= relatedTags.includes(t.id)?"checked" :""%>>
      <label class="form-check-label" for="tag-<%= t.id %>">
      <%= t.name %>
    </label>
    </div>
  <% } %>
</fieldset>