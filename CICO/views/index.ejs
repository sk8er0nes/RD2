<h1 class="mb-4">Food Entries</h1>
<form method="GET" action="/" class="row g-2 mb-4">
  <div class="col-sm">
    <label class="form-label" for="search">Search by food name</label>
    <input class="form-control" type="search" id="search" name="search"
      value="<%= searchTerm %>" placeholder="For example, rice">
  </div>
  <div class="col-sm-auto d-flex align-items-end gap-2">
    <button class="btn btn-primary" type="submit">Search</button>
    <a class="btn btn-outline-secondary" href="/">Clear</a>
  </div>
</form>
<% if (foodEntries.length === 0) { %>
  <div class="alert alert-info" role="status">
    <% if (searchTerm) { %>
      No food entries found for "<%= searchTerm %>".
    <% } else { %>
      There are no food entries yet. Use Add Food Entry to create one.
    <% } %>
  </div>
<% } %>
<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>When</th>
        <th>Food Name</th>
        <th>Calories</th>
        <th>Meal</th>
        <th>Tags</th>
        <th>Serving Size</th>
        <th>Unit</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (let foodEntry of foodEntries) { %>
        <tr>
          <td>
            <%= foodEntry.dateTime.split(' ')[0] %><br/>
            <%= foodEntry.dateTime.split(' ')[1] %>
          </td>
          <td>
            <%= foodEntry.foodName %>
          </td>
          <td>
            <%= foodEntry.calories %>
          </td>
          <td>
            <%= foodEntry.meal %>
          </td>
          <td>
            <% for (const tag of (foodEntry.selected_tags || '').split(',').filter(Boolean)) { %>
              <span class="badge text-bg-primary ms-1 me-1"><%= tag %></span>
            <% } %>
          </td>
          <td><%= foodEntry.servingSize %></td>
          <td><%= foodEntry.unit %></td>
          <td>
            <a class="btn btn-success btn-sm"
              href="food-entry/<%= foodEntry.id %>/edit">Edit</a>
            <a class="btn btn-danger btn-sm"
              href="food-entry/<%= foodEntry.id %>/delete">Delete</a>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>